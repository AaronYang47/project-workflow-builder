{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "project-workflow-builder",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "project-workflow-builder-db",
      "database_id": "86e1d86d-52a3-4134-934f-2b495344f9bc"
    },
    {
      "binding": "FALCON_DB",
      "database_name": "falcon-customer-master",
      "database_id": "a3b49f49-e6b8-41f2-a0a7-fb9a70dd6c9a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "project-workflow-builder-files"
    }
  ]
}
